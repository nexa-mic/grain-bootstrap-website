# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/grainglobal/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/grainglobal/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# Show the branded page while preserving the HTTP 404 status for missing URLs.
ErrorDocument 404 /404.html

RewriteEngine On

# Redirect explicit HTML requests to the public, extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]|$) [NC]
RewriteRule ^(our-organization|events|news|contact|event-startup-summit|event-grasag-congress|news-direction)\.html$ /$1 [R=301,L]

# Serve the existing static files at clean URLs without changing the browser URL.
RewriteRule ^(our-organization|events|news|contact|event-startup-summit|event-grasag-congress|news-direction)$ $1.html [L]
